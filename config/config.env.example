CONFIRM_INSTALL=NO
TIMEZONE=Europe/Paris
OLLAMA_MODEL=llama3.2:3b
# IA locale : vide = conteneur Ollama (CPU). Sur Mac Apple Silicon, Ollama natif utilise le GPU (Metal) et est bien plus rapide :
#   brew install ollama && ollama serve && ollama pull llama3.2:3b   puis OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=
MARTIAN_DB_PASSWORD=CHANGE_ME
BATMAN_DB_PASSWORD=CHANGE_ME
AI_GATEWAY_TOKEN=CHANGE_ME
N8N_ENCRYPTION_KEY=CHANGE_ME
SOC_ADMIN_USER=admin
SOC_ADMIN_PASSWORD=CHANGE_ME
DISCORD_WEBHOOK_URL=
NOTIFY_DRY_RUN=YES
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
# Dossier des journaux Suricata/Zeek/Wazuh (relatif a docker/, cree automatiquement)
LOG_ROOT=../data/logs
COLLECTOR_INTERVAL=5
CTI_INTERVAL=900
CTI_FEEDS=https://www.cert.ssi.gouv.fr/feed/;https://www.cisa.gov/cybersecurity-advisories/all.xml
AUTHORIZED_CIDRS=
DISCOVERY_INTERVAL=3600
SOC_BIND=127.0.0.1
SOC_PORT=8443
# --- Rétention des événements MARTIAN : 90 j en ligne, puis 180 j en archive, puis purge (270 j au total)
RETENTION_ENABLED=YES
RETENTION_ONLINE_DAYS=90
RETENTION_ARCHIVE_DAYS=180
RETENTION_INTERVAL_HOURS=6
# --- HAWKMAN (V11) : veille cyber automatisée
WATCH_INTERVAL=1800
WATCH_NVD_INTERVAL=7200
WATCH_KEV_INTERVAL=21600
WATCH_REPORT_HOUR=7
WATCH_REPORT_MINUTE=30
WATCH_WEEKLY_DAY=0
WATCH_ALERT_MIN_SCORE=80
WATCH_NOTIFY=YES
WATCH_AI_SUMMARY=NO
WATCH_KEYWORDS=
WATCH_RETENTION_DAYS=180
NVD_MIN_CVSS=8.0
NVD_API_KEY=
# --- Outils integres (lances automatiquement au demarrage des conteneurs)
# GREEN-ARROW : audit ports local + decouverte ARP des AUTHORIZED_CIDRS (CSV dans le volume green_arrow_results)
AUDIT_INTERVAL=86400
SCAN_FULL_PORTS=NO
# ORACLE-CTI : OSINT passif, UNIQUEMENT domaines a toi / clients avec accord (separes par des virgules)
OSINT_DOMAINS=
OSINT_INTERVAL_HOURS=6
# HAWKMAN : veille cyber RSS (rapports dans /data/veille-cyber)
VEILLE_INTERVALLE=1800
# --- Prophéties (V-Z+) : boucle ORACLE -> GREEN ARROW / HAWKMAN / GREEN LANTERN
# ORACLE croise les CVE (NVD + EPSS + CISA KEV) avec l'inventaire services/versions de GREEN ARROW.
PROPHET_ENABLED=YES
PROPHET_INTERVAL=3600
PROPHET_MIN_PRIORITY=5
# priorité (0-100) à partir de laquelle un humain est prévenu via GREEN LANTERN
PROPHET_NOTIFY=YES
PROPHET_NOTIFY_MIN=50
PROPHET_VERIFY_TIMEOUT_H=2
# criticité par actif (1.0 par défaut, 0.1-3), JSON entre apostrophes. Exemple :
#   ASSET_CRITICALITY='{"192.168.1.10":2.0,"192.168.1.50":0.5}'
ASSET_CRITICALITY=
# GREEN ARROW : relevé des services (nmap -sV, ports courants) sur AUTHORIZED_CIDRS uniquement, puis vérification des prophéties
SERVICE_SCAN=YES
SERVICE_TOP_PORTS=100
PROPHECY_VERIFY=YES
PROPHECY_VERIFY_COOLDOWN=3600
# HAWKMAN : synchro inventaire + prophéties (s) et rehaussement de score des CVE qui vous touchent
WATCH_EXPOSURE_INTERVAL=900
WATCH_PROPHECY_BOOST=30
