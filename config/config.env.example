CONFIRM_INSTALL=NO
TIMEZONE=Europe/Paris
OLLAMA_MODEL=llama3.2:3b
# IA locale : vide = conteneur Ollama (CPU). Sur Mac Apple Silicon, Ollama natif utilise le GPU (Metal) et est bien plus rapide :
#   brew install ollama && ollama serve && ollama pull llama3.2:3b   puis OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=
MARTIAN_DB_PASSWORD=CHANGE_ME
BATMAN_DB_PASSWORD=CHANGE_ME
AI_GATEWAY_TOKEN=CHANGE_ME
N8N_ENCRYPTION_KEY=CHANGE_ME
SOC_ADMIN_USER=admin
SOC_ADMIN_PASSWORD=CHANGE_ME
DISCORD_WEBHOOK_URL=
NOTIFY_DRY_RUN=YES
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
# Dossier des journaux Suricata/Zeek/Wazuh (relatif a docker/, cree automatiquement)
LOG_ROOT=../data/logs
COLLECTOR_INTERVAL=5
CTI_INTERVAL=900
CTI_FEEDS=https://www.cert.ssi.gouv.fr/feed/;https://www.cisa.gov/cybersecurity-advisories/all.xml
AUTHORIZED_CIDRS=
DISCOVERY_INTERVAL=3600
SOC_BIND=127.0.0.1
SOC_PORT=8443
# --- WATCHTOWER (V11) : veille cyber automatisée
WATCH_INTERVAL=1800
WATCH_NVD_INTERVAL=7200
WATCH_KEV_INTERVAL=21600
WATCH_REPORT_HOUR=7
WATCH_REPORT_MINUTE=30
WATCH_WEEKLY_DAY=0
WATCH_ALERT_MIN_SCORE=80
WATCH_NOTIFY=YES
WATCH_AI_SUMMARY=NO
WATCH_KEYWORDS=
WATCH_RETENTION_DAYS=180
NVD_MIN_CVSS=8.0
NVD_API_KEY=
# --- Outils integres (lances automatiquement au demarrage des conteneurs)
# GREEN-ARROW : audit ports local + decouverte ARP des AUTHORIZED_CIDRS (CSV dans le volume green_arrow_results)
AUDIT_INTERVAL=86400
SCAN_FULL_PORTS=NO
# ORACLE-CTI : OSINT passif, UNIQUEMENT domaines a toi / clients avec accord (separes par des virgules)
OSINT_DOMAINS=
OSINT_INTERVAL_HOURS=6
# WATCHTOWER : veille cyber RSS (rapports dans /data/veille-cyber)
VEILLE_INTERVALLE=1800
